# Copy to backend/.env for local Python development.
DATABASE_URL=sqlite:///./pukankov.db
ENVIRONMENT=development
PUBLIC_ORIGIN=http://127.0.0.1:5173
HOLD_SECONDS=300
MAX_SEATS=8
PAYMENT_MODE=simulation

# Optional: password recovery email. No email is claimed sent without SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Docker Compose: generate a random hexadecimal password, do not reuse this text.
POSTGRES_PASSWORD=
